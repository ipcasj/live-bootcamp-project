{
  "dashboard": {
    "id": null,
    "title": "Live Bootcamp Project Logs",
    "tags": ["loki", "logs", "rust"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Auth Service Logs",
        "type": "logs",
        "targets": [
          {
            "expr": "{service=\"auth-service\"}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": true,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true
        }
      },
      {
        "id": 2,
        "title": "App Service Logs",
        "type": "logs",
        "targets": [
          {
            "expr": "{service=\"app-service\"}",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": true,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true
        }
      },
      {
        "id": 3,
        "title": "All Services Logs (Combined)",
        "type": "logs",
        "targets": [
          {
            "expr": "{service=~\"auth-service|app-service\"}",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": true,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true
        }
      },
      {
        "id": 4,
        "title": "Error Logs Only",
        "type": "logs",
        "targets": [
          {
            "expr": "{service=~\"auth-service|app-service\"} |= `ERROR`",
            "refId": "D"
          }
        ],
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 16
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": true,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "refresh": "5s",
    "schemaVersion": 30,
    "version": 1,
    "links": []
  }
}