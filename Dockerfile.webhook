# Python webhook receiver Dockerfile
FROM python:3.9-slim

WORKDIR /app

# Install Flask
RUN pip install flask

# Create log directory
RUN mkdir -p /var/log/webhook

# Copy webhook receiver script
COPY webhook-receiver.py /app/

# Make it executable
RUN chmod +x /app/webhook-receiver.py

EXPOSE 8080

CMD ["python", "webhook-receiver.py"]