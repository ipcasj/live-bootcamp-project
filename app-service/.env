# App Service Environment Configuration

# Auth service connection
AUTH_SERVICE_IP=localhost
AUTH_SERVICE_HOST_NAME=localhost

# Logging Configuration
# Environment: development, testing, production
ENVIRONMENT=development
# Log level: trace, debug, info, warn, error
LOG_LEVEL=info
# Use JSON format for structured logging (recommended for production)
LOG_JSON_FORMAT=false
# Include sensitive data in logs (only for development)
LOG_INCLUDE_SENSITIVE=false