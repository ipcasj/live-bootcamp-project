# Environment variables for Docker Compose
# Copy this file to .env and update with your actual values

# PostgreSQL password - use a strong password for production
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT secret for authentication - generate a secure random key
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_base64_encoded

# Postmark email service authentication token
# Get this from your Postmark account: https://postmarkapp.com/
POSTMARK_AUTH_TOKEN=your_postmark_server_token_here

# Auth service IP for app-service (use auth-service for Docker)
AUTH_SERVICE_IP=auth-service

# Logging Configuration
# Environment: development, testing, production
ENVIRONMENT=production
# Log level: trace, debug, info, warn, error
LOG_LEVEL=warn
# Use JSON format for structured logging (recommended for production)
LOG_JSON_FORMAT=true
# Include sensitive data in logs (set to false for production)
LOG_INCLUDE_SENSITIVE=false
# Enable file logging in addition to console
LOG_TO_FILE=true
# Log file path (when file logging is enabled)
LOG_FILE_PATH=/var/log/auth-service/app.log